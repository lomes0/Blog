{
  "$schema": "http://json.schemastore.org/web-manifest",
  "id": "/",
  "short_name": "Blog",
  "name": "Blog",
  "description": "A blog platform with a rich text editor: LaTeX, Geogebra, Excalidraw, sticky notes and markdown shortcuts. Write posts and organize them into series.",
  "dir": "ltr",
  "lang": "en",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "categories": [
    "productivity"
  ],
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "32x32",
      "type": "image/x-icon"
    },
    {
      "src": "pwa-64x64.png",
      "sizes": "24x24",
      "type": "image/png"
    },
    {
      "src": "pwa-192x192.png",
      "sizes": "24x24",
      "type": "image/png"
    },
    {
      "src": "pwa-512x512.png",
      "sizes": "24x24",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "maskable-icon-512x512.png",
      "sizes": "24x24",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#252b3a",
  "background_color": "#252b3a",
  "display_override": [
    "standalone",
    "window-controls-overlay"
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "auto"
  }
}
