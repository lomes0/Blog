{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,template,error,loading,not-found,global-error,default,sitemap,robots,opengraph-image,icon,apple-icon,manifest}.{ts,tsx}",
    "prisma/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "mcp/**/*.ts"
  ],
  // `src/lib/__tests__` is a spec deliberately awaiting a test runner (see
  // CLAUDE.md § Testing). It has no importer by design, so knip would report it
  // as an unused file on every sweep; that is a decision already taken, not a
  // finding to re-litigate.
  "ignore": [
    "src/lib/__tests__/**"
  ]
}
