{
  "name": "blog-simple",
  "private": true,
  "version": "0.7.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev",
    "build": "next build",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "start": "next start",
    "lint": "next lint",
    "rebuild": "npm run clean && npm run build",
    "check:tdz": "node scripts/check-tdz.mjs",
    "check:nodes": "node scripts/check-node-serialization.mjs",
    "check:codecs": "node scripts/check-codecs.mjs",
    "check:tdz:fix": "node scripts/check-tdz.mjs --fix-hint",
    "check:unused": "knip",
    "check:theme": "node scripts/check-theme.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:server": "node --import tsx --env-file=.env mcp/content-server.ts",
    "mcp:smoke": "node --import tsx mcp/smoke.ts",
    "mcp:smoke:http": "node --import tsx --env-file=.env mcp/smokeHttp.ts",
    "mcp:token": "node --import tsx --env-file=.env prisma/scripts/agent-token.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.9",
    "@ai-sdk/google": "3.0.6",
    "@ai-sdk/openai": "3.0.89",
    "@ai-sdk/react": "3.0.239",
    "@base-ui/react": "^1.7.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@lexical/clipboard": "^0.49.0",
    "@lexical/code": "^0.49.0",
    "@lexical/headless": "^0.49.0",
    "@lexical/html": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/markdown": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/table": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@mui/material": "^6.5.0",
    "@mui/material-nextjs": "^6.4.3",
    "@mui/system": "^6.5.0",
    "@mui/utils": "^6.4.9",
    "@mui/x-charts": "^7.28.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/bundle-analyzer": "^15.5.22",
    "@prisma/client": "^6.19.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@shikijs/langs": "^4.4.3",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/recipes": "^0.5.7",
    "ai": "6.0.27",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "fractional-indexing": "^3.4.0",
    "htmr": "^1.0.2",
    "image-size": "^2.0.1",
    "jotai": "^2.20.2",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "lexical": "^0.49.0",
    "lucide-react": "^1.28.0",
    "mathlive": "^0.110.0",
    "next": "^15.5.22",
    "next-auth": "^4.24.15",
    "nprogress": "^0.2.0",
    "ollama-ai-provider": "^1.2.0",
    "patch-package": "^8.0.0",
    "pg": "^8.22.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-rnd": "^10.5.3",
    "react-use": "^17.6.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "ts-pattern": "^5.6.2",
    "uuid": "^11.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@next/eslint-plugin-next": "^16.1.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.13.10",
    "@types/nprogress": "^0.2.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-glob": "^3.3.3",
    "knip": "^5.88.1",
    "prisma": "^6.19.3",
    "terser-webpack-plugin": "^5.6.1",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "workbox-webpack-plugin": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@radix-ui/react-tabs": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@react-spring/web": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "ajv-keywords": "^5.1.0"
  }
}
