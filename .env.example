NEXTAUTH_URL=""
NEXTAUTH_SECRET=""

# OAuth. `src/lib/auth.ts` registers a provider only when BOTH halves of its
# pair are set, so an unset pair means that button simply never renders — which
# looks identical to a typo'd secret. Set at least one pair or sign-in is
# unavailable. Callback URLs are `{PUBLIC_URL}/api/auth/callback/<provider>`.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google *OAuth* — not the same thing as GOOGLE_GENERATIVE_AI_API_KEY below,
# which is the Gemini key for /api/completion.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

DATABASE_URL=""
PUBLIC_URL=""

# Which user the local (stdio) MCP server acts as, so Claude Code can edit your
# posts from the terminal — a `User` id or the email you signed in with. Leave
# it empty and the server refuses to start; everything else in the app is
# unaffected. `.mcp.json` is committed and deliberately holds no author, so this
# is the only place your identity is named.
MCP_AUTHOR_ID=""

# The change feed's `LISTEN` connection (docs/plans/archive/changes-detection.md §6).
# Leave empty and it uses DATABASE_URL, which is right whenever that is a
# direct connection — the only reason this exists is that `LISTEN` does not
# work through a transaction-mode connection pooler (PgBouncer `transaction`,
# Supabase's `:6543`, Neon's pooled endpoint) and fails *silently*: the
# connection succeeds, the LISTEN succeeds, and notifications simply never
# arrive. If DATABASE_URL is ever pointed at a pooler, put the direct
# connection here.
CHANGES_DATABASE_URL=""

# ---- Blob store (docs/plans/blob-storage.md) --------------------------------
# Content-addressed storage for attachments, backgrounds and editor images.
# Production is Cloudflare R2; locally it is the MinIO service in
# docker-compose.yml, and these values are that service — so a fresh checkout
# gets a working blob store with no edits. Left commented out, nothing falls
# back to disk: `isStorageConfigured()` is false and every /api/blob call throws
# "Blob storage is not configured", next to a MinIO container running fine.
#
# There is ONE bucket. The public/private split does not survive deduplication —
# a blob shared between a published post and a private draft would belong in
# both — so visibility is decided per request by `/api/blob/[hash]`, from the
# documents referencing the blob, and never by which bucket the bytes are in.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
# Credentials are MINIO_ROOT_USER/PASSWORD from docker-compose.yml, and the
# bucket is the one minio-init creates. Replace all three for R2.
S3_ACCESS_KEY_ID="blogblobs"
S3_SECRET_ACCESS_KEY="blogblobs"
S3_BUCKET="blog-blobs"
# Set to "false" only for an endpoint that addresses buckets by subdomain.
S3_FORCE_PATH_STYLE="true"

# Where uploaded attachments are written. Must NOT be inside `public/`: anything
# under the static tree is served by Next with no session and no authorization
# check, bypassing /api/attachments entirely. Defaults to `<cwd>/var/uploads`.
# Point this at a mounted volume in production — the default lives inside the
# container and does not survive a redeploy.
UPLOADS_DIR=""
NEXT_PUBLIC_FASTAPI_URL=""
OLLAMA_API_URL=""
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""

# Azure OpenAI Configuration
AZURE_API_KEY=""
AZURE_OPENAI_BASE_URL="https://staging-openai.azure-api.net/openai-gw-proxy-dev"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"

# Key-encryption keys for users' own AI provider keys — see
# docs/plans/byo-provider-keys.md §4.2. Users enter their own Anthropic/Google/
# Azure key in Settings; it is stored AES-256-GCM-encrypted under one of these,
# so **the database alone is not enough to read them and this variable alone is
# not either**. Losing it means every stored key must be re-entered by its owner.
#
# Format is "version:base64", comma-separated. Each value must decode to exactly
# 32 bytes, and canonical base64 is required (base64url and unpadded are refused
# at startup, because both decode to a plausible-looking wrong key). Generate one:
#
#   node -e 'console.log("1:" + require("node:crypto").randomBytes(32).toString("base64"))'
AI_CREDENTIAL_KEYS=""
# Which version new keys are sealed under. Optional while there is exactly one.
# To rotate: append a version, point this at it, run the re-seal pass, then drop
# the old entry once no row still names it.
AI_CREDENTIAL_KEY_VERSION=""

BROWSERLESS_URL=""

# ---- Production deployment only ---------------------------------------------
# Read by docker-compose.prod.yml; unused in development.
# See docs/plans/production-deployment.md.

# The hostname Caddy obtains a TLS certificate for. Required — the stack refuses
# to start without it. NEXTAUTH_URL and PUBLIC_URL above should both be
# https://<APP_DOMAIN>.
APP_DOMAIN=""

# Postgres credentials for the compose-managed database. Defaults are blog/blog,
# which is fine in development and is not fine on a public box — the service is
# unpublished, but these are also what a restored backup is encrypted against.
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""