# Production .env — copy to /opt/blog-simple/.env on the VPS and fill it in.
#
#   cp .env.production.example .env && chmod 600 .env
#
# This is NOT .env.example. That file is development-shaped: it points S3_* at
# the local MinIO service and leaves the Postgres credentials at blog/blog.
# Copying it onto a box is how you end up running a public site against a
# password published in this repository. See
# docs/plans/production-deployment.md §9 step 5.
#
# Everything here is read at *runtime* by the app container (compose `env_file`)
# except the two variables under "Baked at build time" at the bottom — read
# those before assuming a value set here reaches the browser.
#
# Not in this file, deliberately:
#   DATABASE_URL           — docker-compose.prod.yml sets it to the `postgres`
#                            service. Setting it here does nothing; the compose
#                            `environment:` block wins over `env_file:`.
#   CHANGES_DATABASE_URL   — the change feed falls back to DATABASE_URL, which is
#                            correct with no connection pooler in the topology.
#   UPLOADS_DIR            — defaults to /app/var/uploads, which is where the
#                            blog-attachments volume mounts.
#   MCP_AUTHOR_ID          — the *stdio* MCP server only, which runs on your
#                            laptop. The box serves /api/mcp, authenticated by
#                            agent tokens instead.
#   ANTHROPIC_API_KEY etc. — no such variable exists any more. Each user brings
#                            their own key; see AI_CREDENTIAL_KEYS below.


# ---- Identity ---------------------------------------------------------------

# The hostname Caddy obtains a Let's Encrypt certificate for. The stack refuses
# to start without it. Point the DNS A record at this box *before* first `up`:
# Caddy's ACME challenge is served from port 80 and fails if the name does not
# already resolve here.
APP_DOMAIN="example.com"

# Both must be https://<APP_DOMAIN>, with no trailing slash. NEXTAUTH_URL being
# wrong does not error — it produces OAuth callbacks that redirect to the wrong
# origin, which reads as "sign-in silently does nothing".
NEXTAUTH_URL="https://example.com"
PUBLIC_URL="https://example.com"

# openssl rand -base64 32
NEXTAUTH_SECRET=""


# ---- Database ---------------------------------------------------------------
#
# Consumed by docker-compose.prod.yml, which builds DATABASE_URL from them, and
# by every script in ops/. The compose file and the ops scripts both DEFAULT
# these to blog/blog when unset — so leaving them empty is not an error, it is
# a public box running on a known password. Set all three.
#
# Postgres is unpublished on the compose network and not reachable from outside,
# but these credentials are also what `ops/restore-drill.sh` and any manual
# `pg_restore` authenticate as, and they end up in the backup's provenance.
#
#   openssl rand -base64 24 | tr -d '/+='
POSTGRES_USER="blog"
POSTGRES_PASSWORD=""
POSTGRES_DB="blog"


# ---- OAuth ------------------------------------------------------------------
#
# At least one complete pair, or sign-in is unavailable and the server logs an
# error at startup. A provider registers only when BOTH halves are set, so a
# half-filled pair is indistinguishable from an unset one: the button simply
# never renders.
#
# Callback URL to register with the provider:
#   https://<APP_DOMAIN>/api/auth/callback/github
#   https://<APP_DOMAIN>/api/auth/callback/google
#
# Registration is open — anyone who completes a sign-in gets an account. Access
# is controlled by who has the URL, and the only refusal is a `disabled` row.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google *OAuth*, not a Gemini key.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ---- Blob store — Cloudflare R2 (docs/plans/blob-storage.md) ----------------
#
# THIS BLOCK IS NOT OPTIONAL, and its absence does not crash. With S3_* unset,
# `isStorageConfigured()` returns false, uploads fall back to inlining data URIs
# — the exact behaviour blob-storage spent four phases removing — and every
# existing post renders broken pictures with no error naming the cause.
#
# The bucket is primary data, not a cache. Once Revision.data holds
# /api/blob/<hash>, the object *is* the picture. Create the bucket before the
# first deploy; see docs/plans/production-deployment.md §2.1.
#
# Do not add an object-store service to docker-compose.prod.yml. Development
# runs MinIO; production points off-box at R2, by design.

# R2's S3 endpoint. Account id from the Cloudflare dashboard; no bucket in the
# path.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# R2 ignores the region but the SDK requires one.
S3_REGION="auto"

# An R2 API token scoped to Object Read & Write on this bucket alone.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="blog-blobs"

# Keep "true" for R2: it addresses buckets by path on r2.cloudflarestorage.com
# and does not serve them as subdomains. Setting this "false" produces requests
# to a hostname that does not resolve.
S3_FORCE_PATH_STYLE="true"


# ---- Per-user AI provider keys ----------------------------------------------
#
# The key-encryption keys for the Anthropic/Google/Azure keys users enter in
# Settings. Each is stored AES-256-GCM-encrypted under one of these, so the
# database alone cannot read them and this variable alone cannot either.
#
# Without it, saving a key fails and every already-stored key is unreadable.
# LOSING IT after users have entered keys means every one of them must be
# re-entered by its owner — so it belongs in the backup of secrets you keep
# somewhere other than this box.
#
# Format "version:base64", comma-separated, each decoding to exactly 32 bytes,
# canonical base64 (base64url and unpadded are refused at startup, because both
# decode to a plausible-looking wrong key). Generate:
#
#   node -e 'console.log("1:" + require("node:crypto").randomBytes(32).toString("base64"))'
AI_CREDENTIAL_KEYS=""
# Optional while there is exactly one version.
AI_CREDENTIAL_KEY_VERSION=""


# ---- Optional ---------------------------------------------------------------

# AI endpoints stay deployment config because a user-supplied URL would make the
# server fetch any host the user names from inside its own network. Keys are
# per-user; URLs are per-deployment. Leave empty to disable the provider.
OLLAMA_API_URL=""
AZURE_OPENAI_BASE_URL=""
AZURE_OPENAI_API_VERSION=""

# Remote Chrome for PDF export. Empty falls back to Puppeteer in the container,
# which pulls a ~300MB Chromium — on a 4GB box, prefer a hosted endpoint or
# accept that PDF export is the feature that fails.
BROWSERLESS_URL=""

# DO NOT SET on a public deployment. It accepts an agent token at /api/mcp over
# plain HTTP to a non-loopback host, which publishes the credential. Caddy
# terminates TLS here, so the guard it disables is exactly the one you want.
# MCP_ALLOW_INSECURE=1


# ---- Registry images (CI → GHCR → pull) -------------------------------------
#
# Set these to deploy pre-built images instead of building on the box, and add
# docker-compose.ghcr.yml to the command:
#
#   docker compose -f docker-compose.prod.yml -f docker-compose.ghcr.yml pull
#   docker compose -f docker-compose.prod.yml -f docker-compose.ghcr.yml up -d
#
# Pin a digest or a sha- tag rather than :latest, so that a redeploy and a
# rollback name different things. `ops/lib.sh` keys off APP_IMAGE being set: it
# adds the override file to its own compose calls only when this is non-empty,
# so the `ops` one-shot container pulls rather than building the builder stage
# on a box sized for the runtime.
#
# Leave both empty to build on the box (`up -d --build`) instead.
APP_IMAGE=""
OPS_IMAGE=""


# ---- Baked at build time — setting these here does nothing ------------------
#
# Next inlines NEXT_PUBLIC_* into the client bundle during `pnpm build`, and
# .env is in .dockerignore, so the build never sees this file at all. They are
# Dockerfile build args, passed by .github/workflows/build.yml. To change one,
# rebuild the image; putting a value here changes nothing and looks like it
# should.
#
#   NEXT_PUBLIC_FASTAPI_URL  — the external FastAPI backend behind the editor's
#                              OCR and math tools. Unset disables those two.
