generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Project model: a named grouping of Series in the author's root list.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  authorId    String   @db.Uuid

  // Position in the author's root list. Shares the fractional-index `rank` space
  // with root Documents and root (ungrouped) Series, so projects, loose series
  // and standalone posts interleave freely.
  rank String

  // Relations
  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series Series[] @relation("ProjectSeries")

  @@index([authorId])
  @@index([authorId, rank]) // Root-list ordering (shared space with Series/Documents)
}

// Series model for organizing blog posts
model Series {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  authorId    String   @db.Uuid

  // Optional membership in a Project. When set, this series' `rank` is scoped to
  // its project's members; when null the series lives at the author's root list.
  projectId String? @db.Uuid

  // Position among this series' siblings: the project's members when `projectId`
  // is set, otherwise the author's root list (shared rank space with root
  // Documents), so posts and series freely interleave.
  rank String

  // Relations
  author  User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project Project?   @relation("ProjectSeries", fields: [projectId], references: [id], onDelete: SetNull)
  posts   Document[] @relation("SeriesPosts")

  @@index([authorId])
  @@index([title])
  @@index([authorId, createdAt])
  @@index([authorId, rank]) // Root-list ordering (shared space with Documents)
  @@index([projectId]) // Membership lookups
  @@index([projectId, rank]) // Order of series within a project
}

// Main content model with hierarchical structure (used for both posts and directories)
model Document {
  id          String   @id @default(uuid()) @db.Uuid
  handle      String?  @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String   @db.Uuid
  published   Boolean  @default(false)
  private     Boolean  @default(false)

  // Document-specific fields
  head   String? @db.Uuid
  collab Boolean @default(false)

  // Status field for marking documents as active or done
  status DocumentStatus @default(ACTIVE)

  // Series support for blog posts
  seriesId String? @db.Uuid

  // Background image for posts (optional)
  background_image String?

  // For tabbed posts: the label shown on this document's own tab. Lets the
  // first (root) tab carry a name distinct from the post title in `name`.
  tabLabel String?

  // Manual position among siblings in this document's container (its series,
  // its parent tab-group, or the author's root list). Fractional-index key —
  // see src/lib/ordering.
  rank String

  // Fork relationship
  baseId String?    @db.Uuid
  base   Document?  @relation("BaseForks", fields: [baseId], references: [id], onDelete: SetNull)
  forks  Document[] @relation("BaseForks")

  // Hierarchical relationships (for future features if needed)
  parentId String?    @db.Uuid
  parent   Document?  @relation("DocumentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Document[] @relation("DocumentHierarchy")

  // Type discrimination
  type DocumentType

  // An agent-created post lands normally but stays flagged until you accept it
  // (docs/plans/archive/agent-gating.md §3.7). `published` defaults to false, so this is
  // a draft nobody else can read meanwhile.
  agentCreatedAt DateTime?
  agentOrigin    String?

  // Relations
  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  coauthors DocumentCoauthors[]
  revisions Revision[]
  series    Series?             @relation("SeriesPosts", fields: [seriesId], references: [id], onDelete: SetNull)
  blobs     BlobRef[]

  @@index([seriesId])
  @@index([authorId, published]) // Index for finding user's published posts
  @@index([published, type]) // Index for finding published posts/documents
  @@index([seriesId, rank]) // Order of posts within a series
  @@index([parentId, rank]) // Order of child tabs within a tabbed post
  @@index([authorId, rank]) // Order of the author's root list
}

enum DocumentType {
  DOCUMENT
}

enum DocumentStatus {
  ACTIVE
  DONE
}

model Revision {
  id         String   @id @default(uuid()) @db.Uuid
  data       Json
  createdAt  DateTime @default(now())
  documentId String   @db.Uuid // References posts (Document with type DOCUMENT)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   String   @db.Uuid
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // ── Agent proposals (docs/plans/archive/agent-gating.md §3.1) ──────────────────────
  // A revision with `proposedAt` set is *not* history: it is a pending agent
  // write that `Document.head` does not point at, and every history read
  // filters it out with `proposedAt: null`. Approval clears the flag, which is
  // what turns the row into history; rejection deletes it.
  proposedAt     DateTime?
  origin         String? // where the write came from, e.g. "claude-code"
  // The head this proposal was built on. **Written once**, on creation — a
  // squash must never refresh it (§3.2), because approval's compare-and-set on
  // `Document.head` uses it as the staleness check.
  baseRevisionId String?   @db.Uuid
  ops            Json? // the batches folded into this proposal (§3.3)
  summary        String? // one line, for the rail
  staleAt        DateTime? // set when the base stops being head (§3.6)
  // CAS token for the squash (§3.2). Once `head` stops moving on an agent
  // write, this is the only thing serializing two folds onto the same row.
  version        Int       @default(0)
  // At most one pending proposal per document is enforced by a *partial*
  // unique index, which Prisma cannot express — see the raw SQL in
  // migrations/20260806…_add_revision_proposals.

  @@index([documentId])
  @@index([authorId])
  @@index([documentId, proposedAt])
}

model User {
  id             String              @id @default(uuid()) @db.Uuid
  handle         String?             @unique
  name           String
  email          String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  disabled       Boolean             @default(false)
  emailVerified  DateTime?
  lastLogin      DateTime?
  image          String?
  role           String              @default("user")
  accounts       Account[]
  sessions       Session[]
  revisions      Revision[]
  documents      Document[] // User's posts  
  coauthored     DocumentCoauthors[]
  series         Series[] // User's series for organizing blog posts
  projects       Project[] // User's projects for grouping series
  notesCanvases  NotesCanvas[] // User's note canvases
  copilotThreads CopilotThread[] // User's Copilot conversations
  agentTokens    AgentToken[] // Bearer credentials for the remote MCP endpoint

  providerCredentials ProviderCredential[] // This user's own AI provider API keys

  @@index([email])
  @@index([handle])
}

/// A bearer credential that lets an agent reach this user's content over HTTP
/// without a browser session — see docs/plans/archive/mcp-support.md §4.3.
///
/// The whole security argument for preferring this over OAuth rests on one
/// property, so it is worth stating where the columns are: **`userId` lives on
/// the token and never arrives in a request.** The MCP server takes its author
/// from whoever authenticated, and no tool accepts an author as an argument, so
/// there is no way to spell "act as someone else". A leaked token is scoped to
/// its owner's own posts, in a system where an agent write is already a
/// proposal rather than a commit.
model AgentToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  // Cascade so deleting an account cannot leave live credentials behind — the
  // self-serve account deletion the July audit wants would otherwise ship a
  // hole.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Human label, for the audit trail and for choosing which one to revoke:
  /// "laptop", "ci". Deliberately not unique — revocation is by id, and a
  /// uniqueness constraint would mean re-minting "laptop" after revoking it
  /// needed a different name, since revoked rows are kept (below).
  name String

  /// SHA-256 (hex) of the presented secret. The plaintext is shown once at mint
  /// and never stored, so a database leak does not hand over working
  /// credentials.
  ///
  /// Unsalted and unstretched on purpose: the input is 32 bytes of CSPRNG, not
  /// a password. There is no dictionary to run and nothing to slow down, and a
  /// plain hash is what lets the lookup be a single indexed equality rather
  /// than a scan that compares candidates one at a time.
  hash String @unique

  /// What this token may do: "read" (list/outline/read/search) and "propose"
  /// (apply_ops, create_post). A plain string list rather than an enum, matching
  /// `User.role` — the set will grow, and growing it should not be a migration.
  scopes String[]

  createdAt DateTime @default(now())

  /// Throttled to at most one write a minute per token, so a chatty agent does
  /// not turn every read into a write (mcp_support.md phase 5).
  lastUsedAt DateTime?

  expiresAt DateTime?

  /// Set rather than deleting the row: a revoked token's `lastUsedAt` is
  /// evidence about what a leaked credential did, and deleting destroys it.
  revokedAt DateTime?

  @@index([userId])
}

/// A user's own API key for one AI provider — see docs/plans/archive/byo-provider-keys.md §4.1.
///
/// Read the row above first, then the one difference that shapes everything
/// here: `AgentToken` stores a SHA-256 because the server only ever has to
/// recognise the same string again, but this key is **replayed verbatim** to
/// api.anthropic.com on every completion, so the server must be able to read it
/// back. It is therefore encrypted, not hashed, and the security claim is
/// correspondingly narrower and worth stating where the columns are:
///
///   a dump of this table is useless on its own — the ciphertext is AES-256-GCM
///   under a key that lives in the environment (`AI_CREDENTIAL_KEYS`)
///   a host holding both the database and that environment has every user's key
///
/// The second line is not a defect to be fixed later; it is what "replayable
/// credential" costs. What it buys over keeping the key in the browser is that
/// the plaintext never travels back toward a client, so an XSS in the app
/// cannot exfiltrate it. See §6 of the plan for the full table.
model ProviderCredential {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  // Cascade for the reason AgentToken cascades: deleting an account must not
  // leave live third-party credentials behind.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which provider, spelled as `AIModel.provider` spells it. A plain string
  /// rather than an enum, matching `AgentToken.scopes` and `User.role` — the set
  /// grows, and growing it should not be a migration.
  provider String

  /// The AES-256-GCM parts, in three columns rather than one packed blob: a
  /// malformed row is then a decode failure at a named field instead of an
  /// off-by-one in a parser nobody reads twice.
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes

  /// Which KEK sealed this row. Present in the first migration because
  /// retrofitting rotation means re-encrypting blind — with this column a
  /// rotation is "open under the version the row names, re-seal under the
  /// current one", and it can be resumed after a crash.
  keyVersion Int @default(1)

  /// Last four characters of the plaintext, for the masked display. Four is what
  /// the providers themselves show: enough to tell one of your own keys from
  /// another, not a meaningful fraction of the secret.
  last4 String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Last time a completion used it — the evidence for "is this key still live".
  /// Throttled like `AgentToken.lastUsedAt`; see `shouldTouch`.
  lastUsedAt DateTime?

  /// Last time it was checked against the provider and worked.
  lastVerifiedAt DateTime?

  /// One key per provider per user. Several keys for one provider would need a
  /// "which is the default" concept for no benefit — a user replacing a key
  /// means to replace it, so the write is an upsert.
  @@unique([userId, provider])
  @@index([userId])
}

model DocumentCoauthors {
  documentId String   @db.Uuid
  userEmail  String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([documentId, userEmail])
}

model Account {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @db.Uuid
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Notes Canvas model for organizing sticky notes
model NotesCanvas {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @default("My Notes")
  authorId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notes  Note[]

  @@index([authorId])
}

// Note model for individual sticky notes on a canvas
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  canvasId  String   @db.Uuid
  positionX Float // x position on canvas
  positionY Float // y position on canvas
  width     Float // note width
  height    Float // note height
  title     String? // optional note title
  content   String // note content (Lexical state as JSON string)
  color     String   @default("#FFD700") // note color
  zIndex    Int      @default(0) // stacking order
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  canvas NotesCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@index([canvasId])
  @@index([canvasId, zIndex]) // for efficient z-index queries
}

// A Copilot conversation, persisted per user and per workspace scope.
//
// Threads used to live in localStorage, which made them per-browser rather than
// per-user: two accounts sharing a machine shared their history, and a thread
// did not follow its author to another device. Once the chatbox is a way to
// *act* on the library rather than only ask about it, the thread is the audit
// trail of what was done — see docs/plans/archive/workspace-panes.md §6.3.
model CopilotThread {
  id       String  @id @default(uuid()) @db.Uuid
  authorId String  @db.Uuid
  // The document the conversation is about, or "workspace" for the one started
  // from the home pane. Deliberately a plain string, not a Document relation:
  // a thread outlives the post it discussed, and a deleted post must not take
  // the record of what was done to it with it.
  scope    String
  title    String  @default("Conversation")
  // Exactly one thread per (author, scope) is the live one; the rest are
  // history. Not a database constraint — a partial unique index would make an
  // ordinary "archive then start a new one" a two-statement transaction for no
  // gain, since the client owns thread ids and writes both in order.
  current  Boolean @default(false)
  // UIMessage[] as the AI SDK serializes it. Opaque here on purpose: `parts`
  // is an open union owned by that library, and restating it in SQL would be a
  // second source of truth that drifts.
  messages Json

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, scope, updatedAt])
}

// A stored binary, addressed by the SHA-256 of its own bytes.
//
// Content addressing is the point, not an implementation detail: the same image
// pasted into twenty revisions is one row and one object, because the key is
// derived from the content rather than assigned per upload. See
// docs/plans/blob-storage.md §2 for the measurement that chose this — six
// distinct images were being stored 141 times.
model Blob {
  // Lowercase hex SHA-256. 64 chars, fixed.
  hash      String   @id @db.VarChar(64)
  size      Int
  mimeType  String
  createdAt DateTime @default(now()) @db.Timestamptz

  refs BlobRef[]
}

// Which documents reference a blob.
//
// This table is not bookkeeping — it is what makes a blob authorizable and
// collectable at all (blob-storage.md §4, §5). Under deduplication a blob has no
// ACL of its own, so the question "may this caller read these bytes?" is only
// answerable through the documents pointing at it.
//
// Deliberately keyed per *document*, not per revision: revisions churn on every
// save, and a reference table that churned with them would reintroduce exactly
// the write amplification this design exists to remove.
model BlobRef {
  blobHash   String   @db.VarChar(64)
  documentId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz

  blob     Blob     @relation(fields: [blobHash], references: [hash], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([blobHash, documentId])
  // Answering "which blobs does this document reference?" — the diff performed
  // on every content save, and the reverse direction the primary key cannot serve.
  @@index([documentId])
}
