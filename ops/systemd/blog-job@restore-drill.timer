# Monthly restore rehearsal — docs/plans/production-deployment.md §5: "Restore
# must be rehearsed, on a schedule, or it is not a backup."
#
# This is the only timer here that verifies the other three. It stands up a
# throwaway Postgres and MinIO, restores into them from OFFSITE, and fails if a
# single referenced blob is missing.

[Unit]
Description=blog-simple restore rehearsal

[Timer]
# First Saturday of the month. Monthly rather than weekly because the drill
# copies the whole blob bucket out of the offsite provider each time, and egress
# is the one part of this that is metered.
OnCalendar=Sat *-*-01..07 05:17:00 UTC
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
