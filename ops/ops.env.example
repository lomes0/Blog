# Operator configuration for the ops scripts — copy to ops/ops.env on the box.
# docs/plans/production-deployment.md §5 and §9.
#
# This file is read by every job in ops/. It is deliberately separate from the
# application's .env: nothing here is read by the app, and the app's secrets are
# not exported into a backup job's environment.

# ---- Where backups land ------------------------------------------------------

# On-box staging. One day's dump plus the attachments tarball; pruned to
# LOCAL_KEEP_DAYS. This is not the backup — the offsite copy is.
BACKUP_DIR="/var/backups/blog-simple"

# Markers the jobs write to each other. blobs-collect.sh refuses to run without
# a recent success marker from blobs-sync.sh, so this directory is load-bearing
# rather than cosmetic.
STATE_DIR="/var/lib/blog-simple"

LOCAL_KEEP_DAYS=7

# ---- Offsite (rclone) --------------------------------------------------------
#
# Configure with `rclone config` as root, since the timers run as root. Two
# remotes are needed and they must be at DIFFERENT providers from each other and
# from R2 — backing R2 up to R2 satisfies the letter of "offsite" and none of
# its point (§5).
#
# Point OFFSITE_REMOTE at an rclone *crypt* remote wrapping the destination if
# you want the dumps encrypted at rest: the dump carries every post, every user
# row, the SHA-256 of every agent token and the ciphertext of every AI provider
# key. No script here does its own encryption, precisely so that this choice is
# one line of rclone config rather than a key this layer would then have to
# manage.

# Destination for the nightly database + attachments backup.
OFFSITE_REMOTE="b2:blog-simple-backups"

# The live blob bucket, as an rclone remote. Same bucket S3_BUCKET names.
BLOBS_SOURCE_REMOTE="r2:blog-blobs"

# Destination for the blob copy. A different provider from BLOBS_SOURCE_REMOTE.
BLOBS_OFFSITE_REMOTE="b2:blog-simple-blobs"

# Retention offsite, per class. Promotion is by date: Sunday to weekly, the 1st
# to monthly. 7 / 4 / 6 is §5's default and costs almost nothing at this volume.
OFFSITE_DAILY_KEEP="7d"
OFFSITE_WEEKLY_KEEP="28d"
OFFSITE_MONTHLY_KEEP="186d"

# How stale the last successful blob copy may be before blobs-collect.sh
# refuses to delete anything. Must exceed the blobs-sync timer's interval.
BLOBS_SYNC_MAX_AGE_DAYS=8

# ---- Alerting ----------------------------------------------------------------
#
# Any job failure runs ops/alert.sh through systemd's OnFailure=. Leave the
# webhook empty and failures are journald-only, which means nobody finds out —
# §5's "the cron job broke in March".
ALERT_WEBHOOK=""
ALERT_LABEL="blog-simple"
